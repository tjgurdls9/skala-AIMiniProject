{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lifecycle HTTP payloads v1",
  "$defs": {
    "ProjectCreate": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "request"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "request": {"type": "string", "minLength": 1, "maxLength": 32000}
      }
    },
    "Project": {
      "type": "object", "additionalProperties": false,
      "required": ["project_id", "title", "created_at"],
      "properties": {
        "project_id": {"$ref": "protocol.v1.schema.json#/$defs/Id"},
        "title": {"type": "string"},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "RunCreate": {
      "type": "object", "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["live", "replay"]},
        "source_run_id": {"$ref": "protocol.v1.schema.json#/$defs/Id"}
      },
      "if": {"properties": {"mode": {"const": "replay"}}},
      "then": {"required": ["source_run_id"]},
      "else": {"not": {"required": ["source_run_id"]}}
    },
    "CommandReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["command_id", "run_id", "status", "accepted_at"],
      "properties": {
        "command_id": {"$ref": "protocol.v1.schema.json#/$defs/Id"},
        "run_id": {"$ref": "protocol.v1.schema.json#/$defs/Id"},
        "status": {"const": "accepted"},
        "accepted_at": {"type": "string", "format": "date-time"}
      }
    },
    "Runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol_version", "live_available", "provider", "model", "model_status", "runner_status", "inference_slots", "external_api_enabled", "deployment_enabled", "reasons"],
      "properties": {
        "protocol_version": {"const": 1},
        "live_available": {"type": "boolean"},
        "provider": {"const": "ollama_local"},
        "model": {"type": ["string", "null"]},
        "model_status": {"enum": ["not_configured", "unavailable", "ready"]},
        "runner_status": {"enum": ["unavailable", "ready"]},
        "inference_slots": {"const": 1},
        "template_id": {"enum": ["requests-v1", "cafemap-v1"]},
        "data_source_status": {"enum": ["not_required", "unconfigured"]},
        "external_api_enabled": {"const": false},
        "deployment_enabled": {"const": false},
        "reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "PlanSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_id",
        "spec_version_id",
        "request_digest",
        "implementation_allowed",
        "unsupported",
        "external"
      ],
      "properties": {
        "template_id": {
          "enum": [
            "requests-v1",
            "cafemap-v1"
          ]
        },
        "spec_version_id": {
          "$ref": "protocol.v1.schema.json#/$defs/Id"
        },
        "request_digest": {
          "$ref": "protocol.v1.schema.json#/$defs/Digest"
        },
        "implementation_allowed": {
          "type": "boolean"
        },
        "unsupported": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "request_quote",
              "reason",
              "requires"
            ],
            "properties": {
              "request_quote": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "requires": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "external": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider",
              "purpose",
              "needs",
              "status",
              "reason"
            ],
            "properties": {
              "provider": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "needs": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "free_eligibility",
                    "key",
                    "quota",
                    "attribution",
                    "consent",
                    "isolation"
                  ]
                }
              },
              "status": {
                "enum": [
                  "unconfirmed",
                  "confirmed",
                  "deferred"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "ReleaseView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "enabled",
        "state",
        "target",
        "details",
        "operations",
        "reason"
      ],
      "properties": {
        "run_id": {
          "$ref": "protocol.v1.schema.json#/$defs/Id"
        },
        "enabled": {
          "const": false
        },
        "state": {
          "enum": [
            "unconfigured",
            "prepared",
            "accepted",
            "applied",
            "uncertain",
            "not_applied",
            "superseded",
            "rolled_back",
            "failed"
          ]
        },
        "target": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "protocol.v1.schema.json#/$defs/ReleaseTarget"
            }
          ]
        },
        "details": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository",
                "environment",
                "image_reference",
                "free_policy",
                "rollback"
              ],
              "properties": {
                "repository": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "url",
                    "branch",
                    "auto_deploy"
                  ],
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri",
                      "pattern": "^https://"
                    },
                    "branch": {
                      "type": "string",
                      "minLength": 1
                    },
                    "auto_deploy": {
                      "type": "boolean"
                    }
                  }
                },
                "environment": {
                  "$ref": "#/$defs/Environment"
                },
                "image_reference": {
                  "type": "string",
                  "minLength": 1
                },
                "free_policy": {
                  "type": "string",
                  "minLength": 1
                },
                "rollback": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "action",
                    "data_policy"
                  ],
                  "properties": {
                    "action": {
                      "const": "unpublish_first_release"
                    },
                    "data_policy": {
                      "const": "preserve_volume_no_schema_migration"
                    }
                  }
                }
              }
            }
          ]
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation_id",
              "action",
              "state",
              "accepted_at",
              "observed_at",
              "reason",
              "volume_preserved"
            ],
            "properties": {
              "operation_id": {
                "$ref": "protocol.v1.schema.json#/$defs/Digest"
              },
              "action": {
                "enum": [
                  "push",
                  "deploy",
                  "rollback"
                ]
              },
              "state": {
                "enum": [
                  "accepted",
                  "applied",
                  "uncertain",
                  "failed",
                  "rolled_back",
                  "not_applied",
                  "superseded"
                ]
              },
              "accepted_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "observed_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "volume_preserved": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Error": {
      "type": "object", "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object", "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {"enum": ["UNAUTHORIZED", "FORBIDDEN", "NOT_FOUND", "VERSION_CONFLICT", "COMMAND_CONFLICT", "STALE_APPROVAL", "INVALID_COMMAND", "PROVIDER_NOT_FREE", "RUNTIME_UNAVAILABLE", "REPLAY_READ_ONLY", "TEMPORARILY_UNAVAILABLE", "CURSOR_INVALID", "INVALID_STATE", "BODY_TOO_LARGE"]},
            "message": {"type": "string"},
            "current_state_version": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "Run": {
      "$ref": "protocol.v1.schema.json#/$defs/Snapshot"
    },
    "Session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "csrf_token",
        "expires_at"
      ],
      "properties": {
        "csrf_token": {
          "type": "string",
          "minLength": 32
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ReplayRecording": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "title",
        "source_run_id",
        "recorded_at",
        "manifest_digest"
      ],
      "properties": {
        "project_id": {
          "$ref": "protocol.v1.schema.json#/$defs/Id"
        },
        "title": {
          "type": "string"
        },
        "source_run_id": {
          "$ref": "protocol.v1.schema.json#/$defs/Id"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "manifest_digest": {
          "$ref": "protocol.v1.schema.json#/$defs/Digest"
        },
        "provenance": {"enum": ["local_ledger", "imported_unsigned"]}
      }
    },
    "ReplayRecordings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ReplayRecording"
      }
    },
    "PlanDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "features",
        "non_goals",
        "acceptance",
        "constraints",
        "assumptions",
        "changes"
      ],
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 50
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 50
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "description"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            }
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 50
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 50
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 50
        }
      }
    },
    "Environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "exposure"
      ],
      "properties": {
        "id": {
          "$ref": "protocol.v1.schema.json#/$defs/Id"
        },
        "label": {
          "type": "string"
        },
        "exposure": {
          "enum": [
            "local",
            "private",
            "public"
          ]
        }
      }
    },
    "PlanView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "features",
        "non_goals",
        "acceptance",
        "constraints",
        "assumptions",
        "changes",
        "spec_version_id",
        "stack",
        "repository",
        "deployment",
        "free_policy",
        "allowed_tools",
        "contract_digests"
      ],
      "properties": {
        "support": {"$ref": "#/$defs/PlanSupport"},
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 50
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 50
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "description"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            }
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 50
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 50
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 50
        },
        "spec_version_id": {
          "$ref": "protocol.v1.schema.json#/$defs/Id"
        },
        "stack": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 50
        },
        "repository": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url",
                "branch"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "branch": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "deployment": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Environment"
            }
          ]
        },
        "free_policy": {
          "enum": [
            "Local Ollama Qwen/DeepSeek only; no paid fallback or external API.",
            "Inference: local Ollama Qwen/DeepSeek only; no paid fallback or external model API. External data: verified free terms, explicit consent, fixed isolated access, no paid overage."
          ]
        },
        "allowed_tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 50
        },
        "contract_digests": {
          "type": "object",
          "additionalProperties": {
            "$ref": "protocol.v1.schema.json#/$defs/Digest"
          },
          "minProperties": 2
        }
      }
    },
    "AcceptanceStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec_version_id", "items"],
      "properties": {
        "spec_version_id": {"oneOf": [{"type": "null"}, {"$ref": "protocol.v1.schema.json#/$defs/Id"}]},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "status": {"enum": ["unmet", "met", "failed", "not_run"]},
              "report_id": {"$ref": "protocol.v1.schema.json#/$defs/Id"}
            }
          }
        }
      }
    },
    "RecordingBundle": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "version", "recorded_at", "project", "snapshot", "events", "artifacts", "exporter", "manifest_digest"],
      "properties": {
        "format": {"const": "lifecycle-recording"}, "version": {"const": 1},
        "recorded_at": {"type": "string", "format": "date-time"},
        "project": {"$ref": "#/$defs/Project"},
        "snapshot": {"$ref": "protocol.v1.schema.json#/$defs/Snapshot"},
        "events": {"type": "array", "minItems": 1, "items": {"$ref": "protocol.v1.schema.json#/$defs/Event"}},
        "artifacts": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["metadata", "content"],
          "properties": {"metadata": {"$ref": "protocol.v1.schema.json#/$defs/Artifact"}, "content": {}}
        }},
        "exporter": {
          "type": "object", "additionalProperties": false, "required": ["revision", "dirty", "python", "contract_digests"],
          "properties": {
            "revision": {"oneOf": [{"type": "null"}, {"$ref": "protocol.v1.schema.json#/$defs/Commit"}]},
            "dirty": {"type": "boolean"}, "python": {"type": "string", "minLength": 1},
            "contract_digests": {"type": "object", "additionalProperties": {"$ref": "protocol.v1.schema.json#/$defs/Digest"}, "minProperties": 2}
          }
        },
        "manifest_digest": {"$ref": "protocol.v1.schema.json#/$defs/Digest"}
      }
    },
    "RecordingImportResult": {
      "type": "object", "additionalProperties": false,
      "required": ["project_id", "run_id", "manifest_digest", "read_only", "provenance"],
      "properties": {
        "project_id": {"$ref": "protocol.v1.schema.json#/$defs/Id"},
        "run_id": {"$ref": "protocol.v1.schema.json#/$defs/Id"},
        "manifest_digest": {"$ref": "protocol.v1.schema.json#/$defs/Digest"},
        "read_only": {"const": true}, "provenance": {"const": "imported_unsigned"}
      }
    },
    "RetrievalEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "method", "status", "model", "sources"],
      "properties": {
        "role": {"enum": ["planner", "builder", "validator", "security"]},
        "method": {"enum": ["keyword", "semantic"]},
        "status": {"enum": ["found", "no_results", "search_error"]},
        "model": {"type": ["string", "null"]},
        "error_code": {"enum": ["MODEL_UNAVAILABLE", "VERSION_CONFLICT", "INVALID_SOURCE", "SEARCH_FAILED"]},
        "sources": {"type": "array", "maxItems": 5, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["chunk_id", "url", "version", "license", "collected_at", "content_digest", "roles", "score"],
          "properties": {
            "chunk_id": {"$ref": "protocol.v1.schema.json#/$defs/Digest"},
            "url": {"type": "string", "format": "uri"},
            "version": {"type": "string", "minLength": 1},
            "license": {"type": "string", "minLength": 1},
            "collected_at": {"type": "string", "format": "date-time"},
            "content_digest": {"$ref": "protocol.v1.schema.json#/$defs/Digest"},
            "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["planner", "builder", "validator", "security"]}},
            "score": {"type": "number"}
          }
        }}
      }
    },
    "ContextEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["spec_version_id", "status", "source_digest", "completed_fragments", "total_fragments", "sources"],
      "properties": {
        "spec_version_id": {"oneOf": [{"type": "null"}, {"$ref": "protocol.v1.schema.json#/$defs/Id"}]},
        "status": {"enum": ["ready", "needs_input"]},
        "source_digest": {"$ref": "protocol.v1.schema.json#/$defs/Digest"},
        "completed_fragments": {"type": "integer", "minimum": 0},
        "total_fragments": {"type": "integer", "minimum": 0},
        "sources": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["request_id", "content_digest", "offset", "length"],
          "properties": {
            "request_id": {"$ref": "protocol.v1.schema.json#/$defs/Id"},
            "content_digest": {"$ref": "protocol.v1.schema.json#/$defs/Digest"},
            "offset": {"type": "integer", "minimum": 0},
            "length": {"type": "integer", "minimum": 1}
          }
        }}
      }
    },
    "Preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "origin",
        "commit_sha"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "origin": {
          "type": "string",
          "format": "uri"
        },
        "commit_sha": {
          "$ref": "protocol.v1.schema.json#/$defs/Commit"
        }
      }
    }
  }
}
