{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lifecycle HTTP payloads v1",
  "$defs": {
    "ProjectCreate": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "request"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "request": {"type": "string", "minLength": 1, "maxLength": 32000}
      }
    },
    "Project": {
      "type": "object", "additionalProperties": false,
      "required": ["project_id", "title", "created_at"],
      "properties": {
        "project_id": {"$ref": "protocol.v1.schema.json#/$defs/Id"},
        "title": {"type": "string"},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "RunCreate": {
      "type": "object", "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["live", "replay"]},
        "source_run_id": {"$ref": "protocol.v1.schema.json#/$defs/Id"}
      },
      "if": {"properties": {"mode": {"const": "replay"}}},
      "then": {"required": ["source_run_id"]},
      "else": {"not": {"required": ["source_run_id"]}}
    },
    "CommandReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["command_id", "run_id", "status", "accepted_at"],
      "properties": {
        "command_id": {"$ref": "protocol.v1.schema.json#/$defs/Id"},
        "run_id": {"$ref": "protocol.v1.schema.json#/$defs/Id"},
        "status": {"const": "accepted"},
        "accepted_at": {"type": "string", "format": "date-time"}
      }
    },
    "Runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol_version", "live_available", "provider", "model", "model_status", "runner_status", "inference_slots", "external_api_enabled", "deployment_enabled", "reasons"],
      "properties": {
        "protocol_version": {"const": 1},
        "live_available": {"type": "boolean"},
        "provider": {"const": "ollama_local"},
        "model": {"type": ["string", "null"]},
        "model_status": {"enum": ["not_configured", "unavailable", "ready"]},
        "runner_status": {"enum": ["unavailable", "ready"]},
        "inference_slots": {"const": 1},
        "external_api_enabled": {"const": false},
        "deployment_enabled": {"const": false},
        "reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "Error": {
      "type": "object", "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object", "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {"enum": ["UNAUTHORIZED", "FORBIDDEN", "NOT_FOUND", "VERSION_CONFLICT", "COMMAND_CONFLICT", "STALE_APPROVAL", "INVALID_COMMAND", "PROVIDER_NOT_FREE", "RUNTIME_UNAVAILABLE", "REPLAY_READ_ONLY", "TEMPORARILY_UNAVAILABLE", "CURSOR_INVALID", "INVALID_STATE", "BODY_TOO_LARGE"]},
            "message": {"type": "string"},
            "current_state_version": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "Run": {
      "$ref": "protocol.v1.schema.json#/$defs/Snapshot"
    },
    "Session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "csrf_token",
        "expires_at"
      ],
      "properties": {
        "csrf_token": {
          "type": "string",
          "minLength": 32
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ReplayRecording": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "title",
        "source_run_id",
        "recorded_at",
        "manifest_digest"
      ],
      "properties": {
        "project_id": {
          "$ref": "protocol.v1.schema.json#/$defs/Id"
        },
        "title": {
          "type": "string"
        },
        "source_run_id": {
          "$ref": "protocol.v1.schema.json#/$defs/Id"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "manifest_digest": {
          "$ref": "protocol.v1.schema.json#/$defs/Digest"
        }
      }
    },
    "ReplayRecordings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ReplayRecording"
      }
    },
    "PlanDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "features",
        "non_goals",
        "acceptance",
        "constraints",
        "assumptions",
        "changes"
      ],
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 50
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 50
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "description"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            }
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 50
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 50
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 50
        }
      }
    },
    "Environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "exposure"
      ],
      "properties": {
        "id": {
          "$ref": "protocol.v1.schema.json#/$defs/Id"
        },
        "label": {
          "type": "string"
        },
        "exposure": {
          "enum": [
            "local",
            "private",
            "public"
          ]
        }
      }
    },
    "PlanView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "features",
        "non_goals",
        "acceptance",
        "constraints",
        "assumptions",
        "changes",
        "spec_version_id",
        "stack",
        "repository",
        "deployment",
        "free_policy",
        "allowed_tools",
        "contract_digests"
      ],
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 50
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 50
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "description"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            }
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 50
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 50
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 50
        },
        "spec_version_id": {
          "$ref": "protocol.v1.schema.json#/$defs/Id"
        },
        "stack": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 50
        },
        "repository": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url",
                "branch"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "branch": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "deployment": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Environment"
            }
          ]
        },
        "free_policy": {
          "const": "Local Ollama Qwen/DeepSeek only; no paid fallback or external API."
        },
        "allowed_tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 50
        },
        "contract_digests": {
          "type": "object",
          "additionalProperties": {
            "$ref": "protocol.v1.schema.json#/$defs/Digest"
          },
          "minProperties": 2
        }
      }
    },
    "AcceptanceStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec_version_id", "items"],
      "properties": {
        "spec_version_id": {"oneOf": [{"type": "null"}, {"$ref": "protocol.v1.schema.json#/$defs/Id"}]},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "status": {"enum": ["unmet", "met", "failed", "not_run"]},
              "report_id": {"$ref": "protocol.v1.schema.json#/$defs/Id"}
            }
          }
        }
      }
    },
    "Preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "origin",
        "commit_sha"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "origin": {
          "type": "string",
          "format": "uri"
        },
        "commit_sha": {
          "$ref": "protocol.v1.schema.json#/$defs/Commit"
        }
      }
    }
  }
}
