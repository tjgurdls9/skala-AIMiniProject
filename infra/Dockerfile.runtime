ARG PYTHON_BASE=python:3.11-alpine
FROM ${PYTHON_BASE}
WORKDIR /app
RUN apk add --no-cache zlib=1.3.2-r1
COPY templates/requests-v1/requirements.lock /tmp/requirements.lock
RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements.lock \
    && python -m pip uninstall -y pip setuptools wheel \
    && mkdir /data && chown 65534:65534 /data
USER 65534:65534
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
CMD ["python", "-m", "uvicorn", "app_backend.main:app", "--host", "0.0.0.0", "--port", "8080", "--no-proxy-headers", "--no-access-log"]
